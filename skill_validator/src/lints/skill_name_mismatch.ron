SkillLint(
    id: "skill_name_mismatch",
    human_readable_name: "SKILL.md name does not match convention",
    description: "The frontmatter `name` does not match the expected <group>-<skill-folder> pattern.",
    lint_level: Deny,
    reference_link: Some("https://agentskills.io/specification#name-field"),
    query: r#"
    {
        Skill {
            has_frontmatter @filter(op: "=", value: ["$true"])
            name @filter(op: "is_not_null") @output
            expected_name @tag(name: "expected") @output
            name @filter(op: "!=", value: ["%expected"])

            skill_file_path @output

            span_: frontmatter_span @optional {
                filename @output
                begin_line @output
                end_line @output
            }
        }
    }"#,
    arguments: {
        "true": true,
    },
    error_message: "The `name` field in SKILL.md frontmatter does not match the expected naming convention (<group>-<skill-folder>).",
    per_result_error_template: Some("{{skill_file_path}} frontmatter name '{{name}}' does not match expected '{{expected_name}}'"),
)
